{
  "case_id": "CASE-002",
  "category": "adaptive_large_neighborhood_search_with_cp_sat",
  "description": [
    "Initialization: Build routes by greedily inserting orders in ascending delivery-window deadline order, then initialize the current and best solutions.\n\n",
    "Search:\n",
    "- Operator selection: Select a destroy operator and a repair operator independently by weighted roulette, related to ALG-003; the scoring rules differ from that reference.\n",
    "- Destroy: Remove orders using random, relatedness, worst-contribution, or whole-route removal. The relatedness variant uses one seed and picks the closest orders; the worst-contribution variant ranks once. They differ from the randomized, iterative paper-based references ALG-008 and ALG-009.\n",
    "- Repair: Reinsert removed orders with greedy, regret-2, or noise-perturbed insertion; regret-2 is related to ALG-004 but uses the case implementation. Discard an attempt if repair fails or the implementation's solution-feasibility check fails.\n",
    "- Acceptance and scoring: Apply simulated annealing to the candidate, related to ALG-007; this case has a minimum temperature. Score the selected operators for a new best, an improvement, or an accepted candidate; update their weights and cool the temperature at segment boundaries.\n",
    "- Route refinement: At the configured interval after a successful attempt, use CP-SAT to reorder individual routes. Per-route candidates are checked by the implementation; changed routes replace the current routes when the reported cost is finite.\n",
    "- Termination: Stop at the iteration limit or when the wall-clock limit is noticed at the start of an iteration.\n\n",
    "Scope: This is a third-party ALNS + CP-SAT variant for PDPTW, not the 2006 authors' implementation. It does not call the project reference implementations. Its initial insertion and feasibility/cost checks have known limitations documented in the accompanying case note; validate returned solutions independently."
  ],
  "code": [
    "# --- FILE: alns_pdptw/acceptance.py ---",
    "# -*- coding: utf-8 -*-",
    "\"\"\"",
    "接受准则：模拟退火。",
    "\"\"\"",
    "",
    "import math",
    "",
    "",
    "class SimulatedAnnealing:",
    "    \"\"\"",
    "    模拟退火接受准则。",
    "    温度高时接受差解，温度低时只接受更好的解。",
    "    \"\"\"",
    "",
    "    def __init__(self, init_temp, cooling_rate, min_temp):",
    "        # 初始温度",
    "        self.temp = init_temp",
    "        # 冷却率（每轮乘以此系数）",
    "        self.cooling_rate = cooling_rate",
    "        # 最低温度",
    "        self.min_temp = min_temp",
    "",
    "    def accept(self, curr_cost, new_cost, rng):",
    "        \"\"\"",
    "        判断是否接受新解。",
    "        curr_cost: 当前解成本",
    "        new_cost : 新解成本",
    "        \"\"\"",
    "        # 新解更好，直接接受",
    "        if new_cost < curr_cost:",
    "            return True",
    "",
    "        # 温度过低，不再接受差解",
    "        if self.temp <= self.min_temp:",
    "            return False",
    "",
    "        # 概率接受差解：exp(-(new-curr)/T)",
    "        delta = new_cost - curr_cost",
    "        prob = math.exp(-delta / self.temp)",
    "        return rng.random() < prob",
    "",
    "    def cool(self):",
    "        \"\"\"温度下降一步\"\"\"",
    "        self.temp = max(self.temp * self.cooling_rate, self.min_temp)",
    "# --- FILE: alns_pdptw/alns.py ---",
    "# -*- coding: utf-8 -*-",
    "\"\"\"",
    "ALNS 主循环。",
    "流程：",
    "    1. 构建初始解",
    "    2. 循环：选破坏 + 选修复 -> 新解 -> 接受/拒绝",
    "    3. 周期调用 CP-SAT 精修路径",
    "    4. 自适应调整算子权重",
    "\"\"\"",
    "",
    "import time",
    "import random",
    "import numpy as np",
    "",
    "from config import (ALNS_MAX_ITER, ALNS_TIME_LIMIT, ALNS_INIT_TEMP,",
    "                    ALNS_COOLING_RATE, ALNS_MIN_TEMP,",
    "                    DESTROY_MIN, DESTROY_MAX, SEGMENT_SIZE,",
    "                    REACTION_FACTOR, SCORE_NEW_BEST, SCORE_IMPROVE,",
    "                    SCORE_ACCEPT, WEIGHT_MIN,",
    "                    SOLVER_CALL_INTERVAL)",
    "from destroy_ops import DESTROY_OPS",
    "from repair_ops import REPAIR_OPS",
    "from acceptance import SimulatedAnnealing",
    "from insertion import build_initial_solution",
    "from route_optimizer import optimize_route_order",
    "from feasibility import check_route",
    "",
    "",
    "class ALNS:",
    "    \"\"\"ALNS 求解器\"\"\"",
    "",
    "    def __init__(self, data, seed=42):",
    "        self.data = data",
    "        # 独立随机数生成器，便于复现",
    "        self.rng = np.random.default_rng(seed)",
    "        # 破坏和修复算子名字列表",
    "        self.destroy_names = list(DESTROY_OPS.keys())",
    "        self.repair_names = list(REPAIR_OPS.keys())",
    "        # 算子权重初始化为 1",
    "        self.destroy_weights = {n: 1.0 for n in self.destroy_names}",
    "        self.repair_weights = {n: 1.0 for n in self.repair_names}",
    "        # 分段得分与使用次数",
    "        self.destroy_scores = {n: 0.0 for n in self.destroy_names}",
    "        self.repair_scores = {n: 0.0 for n in self.repair_names}",
    "        self.destroy_uses = {n: 0 for n in self.destroy_names}",
    "        self.repair_uses = {n: 0 for n in self.repair_names}",
    "        # 接受准则",
    "        self.sa = SimulatedAnnealing(ALNS_INIT_TEMP, ALNS_COOLING_RATE, ALNS_MIN_TEMP)",
    "        # 最优解记录",
    "        self.best_solution = None",
    "        self.best_cost = float('inf')",
    "        # 求解历史",
    "        self.history = []",
    "",
    "    def _select_operator(self, weights):",
    "        \"\"\"按权重做轮盘赌选择算子\"\"\"",
    "        names = list(weights.keys())",
    "        ws = np.array([weights[n] for n in names], dtype=float)",
    "        ws = ws / ws.sum()  # 归一化",
    "        return self.rng.choice(names, p=ws)",
    "",
    "    def _update_weights(self):",
    "        \"\"\"根据本段得分调整算子权重\"\"\"",
    "        # 破坏算子",
    "        for n in self.destroy_names:",
    "            if self.destroy_uses[n] > 0:",
    "                avg_score = self.destroy_scores[n] / self.destroy_uses[n]",
    "                self.destroy_weights[n] = (",
    "                    (1 - REACTION_FACTOR) * self.destroy_weights[n]",
    "                    + REACTION_FACTOR * avg_score",
    "                )",
    "                self.destroy_weights[n] = max(self.destroy_weights[n], WEIGHT_MIN)",
    "            # 清零本段统计",
    "            self.destroy_scores[n] = 0.0",
    "            self.destroy_uses[n] = 0",
    "        # 修复算子",
    "        for n in self.repair_names:",
    "            if self.repair_uses[n] > 0:",
    "                avg_score = self.repair_scores[n] / self.repair_uses[n]",
    "                self.repair_weights[n] = (",
    "                    (1 - REACTION_FACTOR) * self.repair_weights[n]",
    "                    + REACTION_FACTOR * avg_score",
    "                )",
    "                self.repair_weights[n] = max(self.repair_weights[n], WEIGHT_MIN)",
    "            self.repair_scores[n] = 0.0",
    "            self.repair_uses[n] = 0",
    "",
    "    def solve(self):",
    "        \"\"\"主循环\"\"\"",
    "        start_time = time.time()",
    "",
    "        # ---------- 初始解 ----------",
    "        print(\"[ALNS] 构建初始解...\")",
    "        current = build_initial_solution(self.data)",
    "        current.evaluate(self.data)",
    "        # 记录最优",
    "        self.best_solution = current.copy()",
    "        self.best_cost = current.cost",
    "        print(f\"[ALNS] 初始解成本 = {current.cost:.2f}, 车辆数 = {len(current.routes)}\")",
    "",
    "        # ---------- 主循环 ----------",
    "        for it in range(ALNS_MAX_ITER):",
    "            # 时间检查",
    "            if time.time() - start_time > ALNS_TIME_LIMIT:",
    "                print(f\"[ALNS] 时间限制达到，停止迭代\")",
    "                break",
    "",
    "            # 每 SEGMENT_SIZE 轮更新一次权重",
    "            if it > 0 and it % SEGMENT_SIZE == 0:",
    "                self._update_weights()",
    "                self.sa.cool()",
    "",
    "            # ---------- 选择算子 ----------",
    "            d_name = self._select_operator(self.destroy_weights)",
    "            r_name = self._select_operator(self.repair_weights)",
    "            d_op = DESTROY_OPS[d_name]",
    "            r_op = REPAIR_OPS[r_name]",
    "",
    "            # ---------- 复制解 ----------",
    "            trial = current.copy()",
    "",
    "            # ---------- 破坏 ----------",
    "            num_remove = int(self.rng.integers(DESTROY_MIN, DESTROY_MAX + 1))",
    "            removed = d_op(self.data, trial, num_remove, self.rng)",
    "            if not removed:",
    "                continue",
    "",
    "            # ---------- 修复 ----------",
    "            success = r_op(self.data, trial, removed, self.rng)",
    "            if not success or not trial.is_feasible(self.data):",
    "                # 修复失败，丢弃本次尝试",
    "                self.destroy_uses[d_name] += 1",
    "                self.repair_uses[r_name] += 1",
    "                continue",
    "",
    "            # ---------- 评估 ----------",
    "            trial.evaluate(self.data)",
    "",
    "            # ---------- 接受 / 拒绝 ----------",
    "            accepted = self.sa.accept(current.cost, trial.cost, self.rng)",
    "",
    "            # 得分判断",
    "            if trial.cost < self.best_cost:",
    "                # 更新全局最优",
    "                self.best_solution = trial.copy()",
    "                self.best_cost = trial.cost",
    "                score = SCORE_NEW_BEST",
    "                print(f\"[ALNS] iter {it}: 新最优 {self.best_cost:.2f}, \"",
    "                      f\"车辆数 = {len(self.best_solution.routes)}\")",
    "            elif trial.cost < current.cost:",
    "                # 改进了当前解",
    "                score = SCORE_IMPROVE",
    "            elif accepted:",
    "                # 差解被接受",
    "                score = SCORE_ACCEPT",
    "            else:",
    "                score = 0.0",
    "",
    "            # 更新算子统计",
    "            self.destroy_scores[d_name] += score",
    "            self.repair_scores[r_name] += score",
    "            self.destroy_uses[d_name] += 1",
    "            self.repair_uses[r_name] += 1",
    "",
    "            # 接受则更新当前解",
    "            if accepted:",
    "                current = trial",
    "",
    "            # 定期用 CP-SAT 精修路径",
    "            if it > 0 and it % SOLVER_CALL_INTERVAL == 0:",
    "                self._solver_refine(current)",
    "",
    "            # 记录历史",
    "            self.history.append(current.cost)",
    "",
    "        # ---------- 输出 ----------",
    "        elapsed = time.time() - start_time",
    "        print(f\"\\n[ALNS] 结束，耗时 {elapsed:.1f}s\")",
    "        print(f\"[ALNS] 最优成本 = {self.best_cost:.2f}\")",
    "        print(f\"[ALNS] 车辆数 = {len(self.best_solution.routes)}\")",
    "        return self.best_solution",
    "",
    "    def _solver_refine(self, current_solution):",
    "        \"\"\"用 CP-SAT 精修每条路径 (安全版本)\"\"\"",
    "        print(f\"  [Solver] 开始 CP-SAT 精修...\")",
    "        improved = 0",
    "        ",
    "        # 1. 在临时副本上操作，绝不轻易触碰 current_solution",
    "        trial_solution = current_solution.copy()",
    "        ",
    "        for r_idx in range(len(trial_solution.routes)):",
    "            old_route = trial_solution.routes[r_idx]",
    "            new_route = optimize_route_order(self.data, old_route)",
    "            if new_route != old_route:",
    "                trial_solution.routes[r_idx] = new_route",
    "                improved += 1",
    "",
    "        if improved > 0:",
    "            # 2. 评估精修后的临时解",
    "            trial_solution.evaluate(self.data)",
    "            ",
    "            # 3. 关键拦截：如果精修导致不可行（cost = inf），立即放弃本次精修",
    "            if trial_solution.cost == float('inf'):",
    "                print(\"  [Solver] 精修导致违反约束，解不可行，放弃本次精修。\")",
    "                return",
    "                ",
    "            print(f\"  [Solver] 精修 {improved} 条路径，新成本 {trial_solution.cost:.2f}\")",
    "            ",
    "            # 4. 确认变好了，才更新 current_solution 和全局最优",
    "            current_solution.routes = trial_solution.routes",
    "            current_solution.cost = trial_solution.cost",
    "            ",
    "            if trial_solution.cost < self.best_cost:",
    "                self.best_solution = trial_solution.copy()",
    "                self.best_cost = trial_solution.cost",
    "                print(f\"  [Solver] 新全局最优 {self.best_cost:.2f}\")",
    "# --- FILE: alns_pdptw/config.py ---",
    "# -*- coding: utf-8 -*-",
    "\"\"\"",
    "ALNS + CP-SAT 求解 PDPTW 的全局配置。",
    "所有可调参数集中在这里，方便做对比实验。",
    "\"\"\"",
    "",
    "# ==================== 问题规模 ====================",
    "NUM_ORDERS = 100                    # 订单数量",
    "NUM_NODES = 2 * NUM_ORDERS + 1      # 总节点数 = 201（含仓库）",
    "DEPOT = 0                           # 仓库节点编号",
    "",
    "# ==================== 车辆参数 ====================",
    "CAPACITY = 10                       # 车辆最大载重",
    "MAX_ROUTE_DURATION = 10000          # 单条路径最大总时长（分钟）",
    "MAX_ORDERS_PER_ROUTE = 5            # 单条路径最多服务订单数",
    "VEHICLE_FIXED_COST = 1000           # 每启用一辆车的固定成本",
    "",
    "# ==================== 地图参数 ====================",
    "MAP_WIDTH = 40.0                    # 地图宽度",
    "MAP_HEIGHT = 40.0                   # 地图高度",
    "",
    "# ==================== ALNS 参数 ====================",
    "ALNS_MAX_ITER = 3000                # ALNS 最大迭代次数",
    "ALNS_TIME_LIMIT = 300.0             # ALNS 总时间限制（秒）",
    "ALNS_INIT_TEMP = 50.0               # 初始温度（模拟退火）",
    "ALNS_COOLING_RATE = 0.9997          # 冷却率",
    "ALNS_MIN_TEMP = 0.1                 # 最低温度",
    "DESTROY_MIN = 5                     # 每次破坏最少移除订单数",
    "DESTROY_MAX = 20                    # 每次破坏最多移除订单数",
    "",
    "# ==================== 自适应权重 ====================",
    "SEGMENT_SIZE = 100                  # 每多少轮更新一次算子权重",
    "REACTION_FACTOR = 0.2               # 权重反应系数",
    "SCORE_NEW_BEST = 10.0               # 找到新全局最优的得分",
    "SCORE_IMPROVE = 5.0                 # 改进当前解的得分",
    "SCORE_ACCEPT = 2.0                  # 被接受的次优解的得分",
    "WEIGHT_MIN = 0.05                   # 算子权重下限（防止归零）",
    "",
    "# ==================== CP-SAT 求解器参数 ====================",
    "SOLVER_CALL_INTERVAL = 50          # 每多少轮 ALNS 调用一次 CP-SAT",
    "SOLVER_ROUTE_TIME_LIMIT = 1.0       # 单条路径 CP-SAT 时间限制（秒）",
    "# --- FILE: alns_pdptw/data.py ---",
    "# -*- coding: utf-8 -*-",
    "\"\"\"",
    "PDPTW 数据生成器。",
    "\"\"\"",
    "",
    "import numpy as np",
    "from config import (NUM_ORDERS, NUM_NODES, DEPOT, MAP_WIDTH, MAP_HEIGHT,",
    "                    CAPACITY, MAX_ROUTE_DURATION)",
    "",
    "",
    "class PDPTWData:",
    "    \"\"\"",
    "    PDPTW 问题数据容器。",
    "",
    "    节点编号：",
    "        0            -> 仓库",
    "        1..NUM_ORDERS -> 取货点（订单 i 的取货点是 i+1）",
    "        NUM_ORDERS+1..2*NUM_ORDERS -> 送货点（订单 i 的送货点是 i+1+NUM_ORDERS）",
    "    \"\"\"",
    "",
    "    def __init__(self, seed=42):",
    "        # 固定随机种子，保证结果可复现",
    "        np.random.seed(seed)",
    "",
    "        # ---------- 1. 生成坐标 ----------",
    "        self.coords = np.zeros((NUM_NODES, 2))",
    "        self.coords[DEPOT] = [MAP_WIDTH / 2, MAP_HEIGHT / 2]",
    "",
    "        for order_id in range(NUM_ORDERS):",
    "            px = np.random.uniform(5, MAP_WIDTH - 5)",
    "            py = np.random.uniform(5, MAP_HEIGHT - 5)",
    "            dx = px + np.random.uniform(-15, 15)",
    "            dy = py + np.random.uniform(-15, 15)",
    "            dx = np.clip(dx, 1, MAP_WIDTH - 1)",
    "            dy = np.clip(dy, 1, MAP_HEIGHT - 1)",
    "",
    "            pickup_node = order_id + 1",
    "            delivery_node = order_id + 1 + NUM_ORDERS",
    "            self.coords[pickup_node] = [px, py]",
    "            self.coords[delivery_node] = [dx, dy]",
    "",
    "        # ---------- 2. 距离矩阵 ----------",
    "        self.dist = np.zeros((NUM_NODES, NUM_NODES))",
    "        for i in range(NUM_NODES):",
    "            for j in range(NUM_NODES):",
    "                self.dist[i][j] = np.sqrt(",
    "                    (self.coords[i][0] - self.coords[j][0]) ** 2 +",
    "                    (self.coords[i][1] - self.coords[j][1]) ** 2",
    "                )",
    "",
    "        # ---------- 3. 订单需求 ----------",
    "        self.demand = np.zeros(NUM_NODES, dtype=int)",
    "        for order_id in range(NUM_ORDERS):",
    "            d = np.random.randint(1, 4)",
    "            self.demand[order_id + 1] = d",
    "            self.demand[order_id + 1 + NUM_ORDERS] = -d",
    "",
    "        # ---------- 4. 时间窗 ----------",
    "        self.tw_start = np.zeros(NUM_NODES)",
    "        self.tw_end = np.zeros(NUM_NODES)",
    "",
    "        self.tw_start[DEPOT] = 0",
    "        self.tw_end[DEPOT] = MAX_ROUTE_DURATION",
    "",
    "        for order_id in range(NUM_ORDERS):",
    "            p_start = np.random.uniform(0, 60)",
    "            p_width = 120",
    "            pickup_node = order_id + 1",
    "            self.tw_start[pickup_node] = p_start",
    "            self.tw_end[pickup_node] = p_start + p_width",
    "",
    "            d_start = self.tw_end[pickup_node] + 30",
    "            d_width = 200",
    "            delivery_node = order_id + 1 + NUM_ORDERS",
    "            self.tw_start[delivery_node] = d_start",
    "            self.tw_end[delivery_node] = d_start + d_width",
    "",
    "        # ---------- 5. 服务时间 ----------",
    "        self.service_time = np.zeros(NUM_NODES)",
    "        for i in range(1, NUM_NODES):",
    "            self.service_time[i] = np.random.uniform(3, 8)",
    "",
    "        print(f\"[数据生成] {NUM_ORDERS} 个订单，{NUM_NODES} 个节点\")",
    "        print(f\"[数据生成] 仓库坐标: ({self.coords[0][0]:.1f}, {self.coords[0][1]:.1f})\")",
    "",
    "    def order_pickup(self, order_id):",
    "        \"\"\"返回订单 order_id 的取货节点\"\"\"",
    "        return order_id + 1",
    "",
    "    def order_delivery(self, order_id):",
    "        \"\"\"返回订单 order_id 的送货节点\"\"\"",
    "        return order_id + 1 + NUM_ORDERS",
    "",
    "    def node_order(self, node):",
    "        \"\"\"返回节点 node 对应的订单 id，仓库返回 -1\"\"\"",
    "        if node == DEPOT:",
    "            return -1",
    "        if node <= NUM_ORDERS:",
    "            return node - 1",
    "        return node - 1 - NUM_ORDERS",
    "",
    "    def node_type(self, node):",
    "        \"\"\"返回节点类型\"\"\"",
    "        if node == DEPOT:",
    "            return 'depot'",
    "        if node <= NUM_ORDERS:",
    "            return 'pickup'",
    "        return 'delivery'",
    "# --- FILE: alns_pdptw/destroy_ops.py ---",
    "# -*- coding: utf-8 -*-",
    "\"\"\"",
    "破坏算子集合。",
    "每个算子从当前解中移除若干订单，返回被移除的订单 ID 列表。",
    "\"\"\"",
    "",
    "import random",
    "import numpy as np",
    "from config import NUM_ORDERS",
    "",
    "def destroy_random(data, solution, num_remove, rng):",
    "    \"\"\"",
    "    随机移除算子。",
    "    从解中随机挑选 num_remove 个订单移除。",
    "    \"\"\"",
    "    # 收集解中所有订单 ID",
    "    all_orders = []",
    "    for route in solution.routes:",
    "        for node in route:",
    "            if node == 0:",
    "                continue",
    "            if node <= NUM_ORDERS:  # 取货节点",
    "                all_orders.append(node - 1)",
    "",
    "    # 如果订单数量不够，全部移除",
    "    num_remove = min(num_remove, len(all_orders))",
    "    # removed = rng.sample(all_orders, num_remove)",
    "    removed = rng.choice(all_orders, size=num_remove, replace=False).tolist()",
    "",
    "    # 逐个从解中移除",
    "    for oid in removed:",
    "        solution.remove_order(oid)",
    "",
    "    return removed",
    "",
    "",
    "def destroy_shaw(data, solution, num_remove, rng):",
    "    \"\"\"",
    "    Shaw 相关移除算子。",
    "    优先移除地理上或时间上相近的订单（它们往往可以互相替换）。",
    "    \"\"\"",
    "    # 收集所有订单",
    "    all_orders = []",
    "    for route in solution.routes:",
    "        for node in route:",
    "            if node == 0:",
    "                continue",
    "            if node <= NUM_ORDERS:",
    "                all_orders.append(node - 1)",
    "",
    "    if not all_orders:",
    "        return []",
    "",
    "    num_remove = min(num_remove, len(all_orders))",
    "",
    "    # 随机选种子订单",
    "    seed = rng.choice(all_orders)",
    "    seed_pu = data.order_pickup(seed)",
    "",
    "    # 计算所有订单与种子订单的相关度",
    "    # 相关度 = 取货点距离 + 0.5 * 送货点距离 + 0.3 * 时间窗距离",
    "    scored = []",
    "    for oid in all_orders:",
    "        if oid == seed:",
    "            continue",
    "        pu = data.order_pickup(oid)",
    "        de = data.order_delivery(oid)",
    "        de_seed = data.order_delivery(seed)",
    "",
    "        d_pu = data.dist[seed_pu][pu]",
    "        d_de = data.dist[de_seed][de]",
    "        d_tw = abs(data.tw_start[pu] - data.tw_start[seed_pu])",
    "        score = d_pu + 0.5 * d_de + 0.3 * d_tw",
    "        scored.append((score, oid))",
    "",
    "    # 按相关度升序，取前 num_remove - 1 个 + 种子",
    "    scored.sort()",
    "    removed = [seed] + [oid for _, oid in scored[:num_remove - 1]]",
    "",
    "    # 从解中移除",
    "    for oid in removed:",
    "        solution.remove_order(oid)",
    "",
    "    return removed",
    "",
    "",
    "def destroy_worst(data, solution, num_remove, rng):",
    "    \"\"\"",
    "    最差移除算子。",
    "    移除对总成本贡献最大的订单。",
    "    \"\"\"",
    "    from feasibility import check_route",
    "",
    "    # 计算每个订单的移除收益 = 原路径成本 - 移除后路径成本",
    "    order_saving = []",
    "    for r_idx, route in enumerate(solution.routes):",
    "        _, orig_cost, _ = check_route(data, route)",
    "",
    "        # 收集路径内的订单",
    "        orders_in_route = []",
    "        for node in route:",
    "            if node == 0:",
    "                continue",
    "            if node <= NUM_ORDERS:",
    "                orders_in_route.append(node - 1)",
    "",
    "        # 逐个试移除",
    "        for oid in orders_in_route:",
    "            pu = data.order_pickup(oid)",
    "            de = data.order_delivery(oid)",
    "            new_route = [n for n in route if n != pu and n != de]",
    "            if len(new_route) <= 2:",
    "                # 移除后路径为空，收益为原成本",
    "                saving = orig_cost",
    "            else:",
    "                ok, new_cost, _ = check_route(data, new_route)",
    "                saving = orig_cost - new_cost if ok else 0.0",
    "            order_saving.append((saving, oid))",
    "",
    "    # 按收益降序，移除收益最大的",
    "    order_saving.sort(reverse=True)",
    "    num_remove = min(num_remove, len(order_saving))",
    "    removed = [oid for _, oid in order_saving[:num_remove]]",
    "",
    "    for oid in removed:",
    "        solution.remove_order(oid)",
    "",
    "    return removed",
    "",
    "",
    "def destroy_route(data, solution, num_remove, rng):",
    "    \"\"\"",
    "    整条路径移除算子。",
    "    随机选择一条路径，把整条路径上的订单全部移除。",
    "    \"\"\"",
    "    if not solution.routes:",
    "        return []",
    "",
    "    # 随机选一条路径",
    "    # r_idx = rng.randint(0, len(solution.routes) - 1)",
    "    r_idx = rng.integers(0, len(solution.routes))",
    "    route = solution.routes[r_idx]",
    "",
    "    # 收集路径内订单",
    "    removed = []",
    "    for node in route:",
    "        if node == 0:",
    "            continue",
    "        if node <= NUM_ORDERS:",
    "            removed.append(node - 1)",
    "",
    "    # 逐个移除",
    "    for oid in removed:",
    "        solution.remove_order(oid)",
    "",
    "    return removed",
    "",
    "",
    "# 破坏算子注册表：名字 -> 函数",
    "DESTROY_OPS = {",
    "    \"random\": destroy_random,",
    "    \"shaw\": destroy_shaw,",
    "    \"worst\": destroy_worst,",
    "    \"route\": destroy_route,",
    "}",
    "# --- FILE: alns_pdptw/feasibility.py ---",
    "# -*- coding: utf-8 -*-",
    "\"\"\"",
    "路径可行性检查与成本计算。",
    "所有破坏/修复算子生成的候选路径，都要经过这里验证。",
    "\"\"\"",
    "",
    "from config import (CAPACITY, MAX_ROUTE_DURATION, DEPOT, NUM_ORDERS, MAX_ORDERS_PER_ROUTE)",
    "",
    "",
    "def check_route(data, route):",
    "    \"\"\"",
    "    检查一条路径是否满足所有约束，并返回行驶距离。",
    "",
    "    参数：",
    "        data : PDPTWData 对象",
    "        route: 节点序列，形如 [0, 5, 105, 0]",
    "",
    "    返回：",
    "        (feasible, cost, msg)",
    "        feasible: bool，是否可行",
    "        cost    : float，路径行驶距离（不可行时为 0）",
    "        msg     : str，错误提示（OK 表示可行）",
    "    \"\"\"",
    "    # 路径非空检查",
    "    if not route or len(route) < 2:",
    "        return False, 0.0, \"路径为空\"",
    "",
    "    # 必须以仓库开始和结束",
    "    if route[0] != DEPOT or route[-1] != DEPOT:",
    "        return False, 0.0, \"路径必须以仓库开始和结束\"",
    "",
    "    # 只有一个仓库节点，视为空路径",
    "    if len(route) == 2:",
    "        return True, 0.0, \"OK\"",
    "",
    "    load = 0            # 当前载重",
    "    time = 0.0          # 当前时间",
    "    cost = 0.0          # 累计距离",
    "    visited = set()     # 已访问节点集合",
    "    picked = set()      # 已取货订单",
    "    delivered = set()   # 已送达订单",
    "    order_count = 0",
    "",
    "    # 遍历每一条边",
    "    for i in range(len(route) - 1):",
    "        cur = route[i]",
    "        nxt = route[i + 1]",
    "",
    "        # 非仓库节点不能重复访问",
    "        if nxt != DEPOT and nxt in visited:",
    "            return False, 0.0, f\"节点 {nxt} 重复访问\"",
    "",
    "        # 计算行驶距离和到达时间",
    "        travel = data.dist[cur][nxt]",
    "        cost += travel",
    "        arrival = time + travel",
    "",
    "        # 时间窗上界检查",
    "        if arrival > data.tw_end[nxt]:",
    "            return False, 0.0, f\"节点 {nxt} 超出时间窗\"",
    "",
    "        # 早到等待，计算离开时间",
    "        start_service = max(arrival, data.tw_start[nxt])",
    "        time = start_service + data.service_time[nxt]",
    "",
    "        # 总时长检查",
    "        if time > MAX_ROUTE_DURATION:",
    "            return False, 0.0, f\"路径总时长超限\"",
    "",
    "        # 更新载重",
    "        load += data.demand[nxt]",
    "",
    "        # 载重不能为负（不能配送未取货订单）",
    "        if load < 0:",
    "            return False, 0.0, f\"节点 {nxt} 处载重为负\"",
    "",
    "        # 载重不能超过容量",
    "        if load > CAPACITY:",
    "            return False, 0.0, f\"节点 {nxt} 处超载\"",
    "",
    "        # 取送配对约束",
    "        order = data.node_order(nxt)",
    "        if order >= 0:",
    "            if nxt <= NUM_ORDERS:",
    "                # 取货节点",
    "                if order in picked:",
    "                    return False, 0.0, f\"订单 {order} 重复取货\"",
    "                picked.add(order)",
    "                # 新增：订单数上限检查",
    "                order_count += 1",
    "                if order_count > MAX_ORDERS_PER_ROUTE:",
    "                    return False, 0.0, f\"单车订单数超限 {order_count} > {MAX_ORDERS_PER_ROUTE}\"",
    "",
    "            else:",
    "                # 送货节点",
    "                if order not in picked:",
    "                    return False, 0.0, f\"订单 {order} 未取货就配送\"",
    "                delivered.add(order)",
    "",
    "        # 记录已访问",
    "        visited.add(nxt)",
    "",
    "    return True, cost, \"OK\"",
    "",
    "",
    "def total_cost(data, routes):",
    "    \"\"\"",
    "    计算整个解的加权总成本：",
    "        总成本 = Σ 路径行驶距离 + 车辆数 × 固定成本",
    "    \"\"\"",
    "    dist_sum = 0.0",
    "    # 累加所有路径的行驶距离",
    "    for route in routes:",
    "        _, cost, _ = check_route(data, route)",
    "        dist_sum += cost",
    "    # 加上每辆车的固定成本",
    "    from config import VEHICLE_FIXED_COST",
    "    return dist_sum + len(routes) * VEHICLE_FIXED_COST",
    "",
    "",
    "def all_orders_served(routes, num_orders):",
    "    \"\"\"",
    "    检查所有订单是否都被服务且只被服务一次。",
    "    \"\"\"",
    "    served = set()",
    "    for route in routes:",
    "        for node in route:",
    "            if node == DEPOT:",
    "                continue",
    "            if node <= num_orders:",
    "                # 取货节点代表一个订单",
    "                served.add(node - 1)",
    "    return len(served) == num_orders",
    "# --- FILE: alns_pdptw/insertion.py ---",
    "# -*- coding: utf-8 -*-",
    "\"\"\"",
    "插入启发式。",
    "把订单（取货点 + 送货点）插入到现有路径中的最优位置。",
    "\"\"\"",
    "",
    "import numpy as np",
    "from feasibility import check_route",
    "from config import VEHICLE_FIXED_COST",
    "",
    "",
    "def best_insertion_in_route(data, route, pu, de):",
    "    \"\"\"",
    "    在指定路径中寻找最优插入位置。",
    "",
    "    做法：",
    "        尝试所有 (i, j) 组合，把 pu 插到位置 i，de 插到位置 j，且 i <= j。",
    "        返回 (增量成本, 新路径)，如果不可行则返回 (inf, None)。",
    "",
    "    参数：",
    "        route: 当前路径节点序列，形如 [0, 5, 105, 0]",
    "        pu   : 取货节点",
    "        de   : 送货节点",
    "    \"\"\"",
    "    best_delta = float('inf')",
    "    best_route = None",
    "",
    "    # 原路径行驶距离",
    "    _, orig_cost, _ = check_route(data, route)",
    "",
    "    # 枚举所有插入位置（i、j 为路径索引）",
    "    for i in range(1, len(route)):",
    "        for j in range(i, len(route)):",
    "            # 构造新路径",
    "            new_route = route[:i] + [pu] + route[i:j] + [de] + route[j:]",
    "            # 可行性检查",
    "            ok, new_cost, _ = check_route(data, new_route)",
    "            if not ok:",
    "                continue",
    "            # 增量成本",
    "            delta = new_cost - orig_cost",
    "            if delta < best_delta:",
    "                best_delta = delta",
    "                best_route = new_route",
    "",
    "    return best_delta, best_route",
    "",
    "",
    "def best_insertion(data, solution, pu, de):",
    "    \"\"\"",
    "    在解的所有路径中寻找最优插入位置。",
    "",
    "    返回：",
    "        (delta, r_idx, new_route)",
    "        delta    : 插入的增量成本（如果新建路径，则为新路径成本 + 固定成本）",
    "        r_idx    : 目标路径索引（-1 表示新建一条路径）",
    "        new_route: 插入后的新路径",
    "    \"\"\"",
    "    best_delta = float('inf')",
    "    best_r_idx = -1",
    "    best_route = None",
    "",
    "    # 尝试插入现有路径",
    "    for r_idx, route in enumerate(solution.routes):",
    "        delta, new_route = best_insertion_in_route(data, route, pu, de)",
    "        if new_route is not None and delta < best_delta:",
    "            best_delta = delta",
    "            best_r_idx = r_idx",
    "            best_route = new_route",
    "",
    "    # 尝试新建一条路径",
    "    new_route = [0, pu, de, 0]",
    "    ok, cost, _ = check_route(data, new_route)",
    "    if ok:",
    "        # 新路径的成本要加上车辆固定成本",
    "        new_cost = cost + VEHICLE_FIXED_COST",
    "        if new_cost < best_delta:",
    "            best_delta = new_cost",
    "            best_r_idx = -1",
    "            best_route = new_route",
    "",
    "    return best_delta, best_r_idx, best_route",
    "",
    "",
    "def insert_order(data, solution, order_id):",
    "    \"\"\"",
    "    把指定订单插入到解中。",
    "    返回是否插入成功。",
    "    \"\"\"",
    "    pu = data.order_pickup(order_id)",
    "    de = data.order_delivery(order_id)",
    "",
    "    delta, r_idx, new_route = best_insertion(data, solution, pu, de)",
    "    if new_route is None:",
    "        return False",
    "",
    "    if r_idx == -1:",
    "        # 新建路径",
    "        solution.routes.append(new_route)",
    "    else:",
    "        # 替换原有路径",
    "        solution.routes[r_idx] = new_route",
    "",
    "    return True",
    "",
    "def build_initial_solution(data):",
    "    \"\"\"构建初始解：按送货时间窗截止时间升序，逐个贪心插入。\"\"\"",
    "    from solution import Solution",
    "    from config import NUM_ORDERS",
    "",
    "    solution = Solution([])",
    "",
    "    # 按送货截止时间排序",
    "    order_dl = []",
    "    for oid in range(NUM_ORDERS):",
    "        de = data.order_delivery(oid)",
    "        order_dl.append((data.tw_end[de], oid))",
    "    order_dl.sort()",
    "",
    "    # 逐个插入",
    "    for _, oid in order_dl:",
    "        insert_order(data, solution, oid)",
    "",
    "    solution.evaluate(data)",
    "    return solution",
    "# --- FILE: alns_pdptw/main.py ---",
    "# -*- coding: utf-8 -*-",
    "\"\"\"",
    "ALNS + CP-SAT 求解 PDPTW 的入口文件。",
    "\"\"\"",
    "",
    "import time",
    "from data import PDPTWData",
    "from alns import ALNS",
    "from feasibility import check_route",
    "from config import DEPOT, NUM_ORDERS",
    "",
    "",
    "def print_solution(data, solution):",
    "    \"\"\"格式化输出最终解\"\"\"",
    "    print(\"\\n\" + \"=\" * 60)",
    "    print(\"最优解详情\")",
    "    print(\"=\" * 60)",
    "",
    "    total_distance = 0.0",
    "    total_orders = 0",
    "",
    "    for idx, route in enumerate(solution.routes):",
    "        # 提取路径服务的订单",
    "        orders = []",
    "        for node in route:",
    "            if node == DEPOT:",
    "                continue",
    "            # if node <= data.__class__.__module__ and False:",
    "            #     pass",
    "            oid = data.node_order(node)",
    "            if oid >= 0 and node <= NUM_ORDERS:",
    "                orders.append(oid)",
    "",
    "        # 计算路径距离",
    "        _, path_cost, _ = check_route(data, route)",
    "        total_distance += path_cost",
    "        total_orders += len(orders)",
    "",
    "        print(f\"\\n路径 {idx + 1}:\")",
    "        print(f\"  节点序列: {[int(n) for n in route]}\")",
    "        print(f\"  服务订单: {[int(o) for o in orders]}\")",
    "        print(f\"  路径成本: {path_cost:.2f}\")",
    "",
    "    print(f\"\\n总路径数（车辆数）: {len(solution.routes)}\")",
    "    print(f\"总服务订单数: {total_orders} / {(len(data.coords) - 1) // 2}\")",
    "    print(f\"纯行驶距离: {total_distance:.2f}\")",
    "    from config import VEHICLE_FIXED_COST",
    "    print(f\"车辆固定成本: {len(solution.routes) * VEHICLE_FIXED_COST:.2f}\")",
    "    print(f\"总目标值: {solution.cost:.2f}\")",
    "",
    "",
    "if __name__ == \"__main__\":",
    "    print(\"=\" * 60)",
    "    print(\"PDPTW ALNS + CP-SAT 求解\")",
    "    print(\"=\" * 60)",
    "",
    "    # 生成数据",
    "    print(\"\\n[步骤1] 生成数据...\")",
    "    data = PDPTWData(seed=42)",
    "",
    "    # 运行 ALNS",
    "    print(\"\\n[步骤2] ALNS 求解...\")",
    "    start = time.time()",
    "    alns = ALNS(data, seed=42)",
    "    solution = alns.solve()",
    "    elapsed = time.time() - start",
    "",
    "    # 输出最终结果",
    "    print_solution(data, solution)",
    "    print(f\"\\n总耗时: {elapsed:.2f}s\")",
    "# --- FILE: alns_pdptw/repair_ops.py ---",
    "# -*- coding: utf-8 -*-",
    "\"\"\"",
    "修复算子集合。",
    "每个算子把若干被移除的订单重新插回解中，返回是否全部插入成功。",
    "\"\"\"",
    "",
    "import random",
    "import numpy as np",
    "from insertion import best_insertion, best_insertion_in_route",
    "",
    "",
    "def repair_greedy(data, solution, removed_orders, rng):",
    "    \"\"\"",
    "    贪心插入算子。",
    "    按顺序逐个把订单插入到当前最优位置。",
    "    \"\"\"",
    "    # 按时间窗截止时间升序",
    "    removed_sorted = sorted(",
    "        removed_orders,",
    "        key=lambda oid: data.tw_end[data.order_delivery(oid)]",
    "    )",
    "",
    "    # 逐个尝试插入",
    "    for oid in removed_sorted:",
    "        pu = data.order_pickup(oid)",
    "        de = data.order_delivery(oid)",
    "        delta, r_idx, new_route = best_insertion(data, solution, pu, de)",
    "        if new_route is None:",
    "            return False   # 插不进去，修复失败",
    "        if r_idx == -1:",
    "            solution.routes.append(new_route)",
    "        else:",
    "            solution.routes[r_idx] = new_route",
    "",
    "    return True",
    "",
    "",
    "def repair_regret(data, solution, removed_orders, rng):",
    "    \"\"\"",
    "    后悔插入算子。",
    "    每次选择“次优插入成本 - 最优插入成本”差值最大的订单先插入。",
    "    思想：让“选择余地小”的订单先占位。",
    "    \"\"\"",
    "    pending = list(removed_orders)",
    "    # 最多尝试 len(pending) 轮",
    "    for _ in range(len(pending)):",
    "        if not pending:",
    "            break",
    "",
    "        # 计算每个订单在所有路径上的最优 + 次优增量",
    "        best_choice = None",
    "        best_regret = -1.0",
    "",
    "        for oid in pending:",
    "            pu = data.order_pickup(oid)",
    "            de = data.order_delivery(oid)",
    "",
    "            deltas = []",
    "            # 尝试所有现有路径",
    "            for r_idx, route in enumerate(solution.routes):",
    "                d, new_route = best_insertion_in_route(data, route, pu, de)",
    "                if new_route is not None:",
    "                    deltas.append((d, r_idx, new_route))",
    "            # 尝试新建路径",
    "            from feasibility import check_route",
    "            from config import VEHICLE_FIXED_COST",
    "            new_route_new = [0, pu, de, 0]",
    "            ok, cost, _ = check_route(data, new_route_new)",
    "            if ok:",
    "                deltas.append((cost + VEHICLE_FIXED_COST, -1, new_route_new))",
    "",
    "            # 排序取最优和次优",
    "            deltas.sort(key=lambda x: x[0])",
    "            if len(deltas) == 0:",
    "                # 完全无法插入，直接退出",
    "                return False",
    "            if len(deltas) == 1:",
    "                regret = float('inf')  # 只有一种选择，优先插",
    "            else:",
    "                regret = deltas[1][0] - deltas[0][0]",
    "",
    "            # 记录后悔值最大的订单",
    "            if regret > best_regret:",
    "                best_regret = regret",
    "                best_choice = (oid, deltas[0])",
    "",
    "        # 插入后悔值最大的订单",
    "        oid, (delta, r_idx, new_route) = best_choice",
    "        if r_idx == -1:",
    "            solution.routes.append(new_route)",
    "        else:",
    "            solution.routes[r_idx] = new_route",
    "        pending.remove(oid)",
    "",
    "    return True",
    "",
    "",
    "def repair_noise(data, solution, removed_orders, rng, noise_factor=0.1):",
    "    \"\"\"",
    "    带噪声的贪心插入。",
    "    在增量成本上加入随机扰动，避免陷入固定模式。",
    "    \"\"\"",
    "    removed_sorted = sorted(",
    "        removed_orders,",
    "        key=lambda oid: data.tw_end[data.order_delivery(oid)]",
    "    )",
    "",
    "    for oid in removed_sorted:",
    "        pu = data.order_pickup(oid)",
    "        de = data.order_delivery(oid)",
    "",
    "        # 遍历所有路径，收集带噪声的候选",
    "        candidates = []",
    "        for r_idx, route in enumerate(solution.routes):",
    "            delta, new_route = best_insertion_in_route(data, route, pu, de)",
    "            if new_route is not None:",
    "                noise = rng.uniform(-noise_factor, noise_factor) * abs(delta + 1)",
    "                candidates.append((delta + noise, r_idx, new_route))",
    "",
    "        # 新建路径也加入候选",
    "        from feasibility import check_route",
    "        from config import VEHICLE_FIXED_COST",
    "        new_route_new = [0, pu, de, 0]",
    "        ok, cost, _ = check_route(data, new_route_new)",
    "        if ok:",
    "            noise = rng.uniform(-noise_factor, noise_factor) * (cost + 1)",
    "            candidates.append((cost + VEHICLE_FIXED_COST + noise, -1, new_route_new))",
    "",
    "        if not candidates:",
    "            return False",
    "",
    "        # 选带噪声后成本最小的",
    "        candidates.sort(key=lambda x: x[0])",
    "        _, r_idx, new_route = candidates[0]",
    "        if r_idx == -1:",
    "            solution.routes.append(new_route)",
    "        else:",
    "            solution.routes[r_idx] = new_route",
    "",
    "    return True",
    "",
    "",
    "# 修复算子注册表",
    "REPAIR_OPS = {",
    "    \"greedy\": repair_greedy,",
    "    \"regret\": repair_regret,",
    "    \"noise\": repair_noise,",
    "}",
    "# --- FILE: alns_pdptw/route_optimizer.py ---",
    "# -*- coding: utf-8 -*-",
    "\"\"\"",
    "CP-SAT 路径内优化器。",
    "给定一条路径上的节点序列，重新排列以获得更短的行驶距离。",
    "\"\"\"",
    "",
    "import numpy as np",
    "from ortools.sat.python import cp_model",
    "from config import (NUM_ORDERS, DEPOT, CAPACITY, MAX_ROUTE_DURATION,",
    "                    SOLVER_ROUTE_TIME_LIMIT)",
    "",
    "",
    "def optimize_route_order(data, route, time_limit=SOLVER_ROUTE_TIME_LIMIT):",
    "    \"\"\"",
    "    用 CP-SAT 重新优化一条路径上的节点顺序。",
    "",
    "    参数：",
    "        data     : PDPTWData",
    "        route    : 现有路径节点序列 [0, pu1, de1, pu2, de2, ..., 0]",
    "        time_limit: 求解时间限制",
    "",
    "    返回：",
    "        新的最优路径（如果求解失败，返回原路径）",
    "    \"\"\"",
    "    # 提取路径上的订单",
    "    orders = []",
    "    seen = set()",
    "    for node in route:",
    "        if node == DEPOT:",
    "            continue",
    "        oid = data.node_order(node)",
    "        if oid >= 0 and oid not in seen:",
    "            orders.append(oid)",
    "            seen.add(oid)",
    "",
    "    M = len(orders)",
    "    if M <= 1:",
    "        # 少于 2 个订单无法优化",
    "        return route",
    "",
    "    # 构造局部节点映射：0=仓库，1..M=取货，M+1..2M=送货",
    "    local_to_actual = {0: DEPOT}",
    "    for idx, oid in enumerate(orders):",
    "        local_to_actual[idx + 1] = data.order_pickup(oid)",
    "        local_to_actual[idx + M + 1] = data.order_delivery(oid)",
    "",
    "    # 计算局部距离矩阵和时间窗",
    "    num_local = 2 * M + 1",
    "    loc_dist = np.zeros((num_local, num_local), dtype=int)",
    "    loc_tw_start = np.zeros(num_local, dtype=int)",
    "    loc_tw_end = np.zeros(num_local, dtype=int)",
    "    loc_service = np.zeros(num_local, dtype=int)",
    "    loc_demand = np.zeros(num_local, dtype=int)",
    "",
    "    SCALE = 1000",
    "    for i in range(num_local):",
    "        node_i = local_to_actual[i]",
    "        loc_tw_start[i] = int(data.tw_start[node_i] * SCALE)",
    "        loc_tw_end[i] = int(data.tw_end[node_i] * SCALE)",
    "        loc_service[i] = int(data.service_time[node_i] * SCALE)",
    "        loc_demand[i] = int(data.demand[node_i])",
    "        for j in range(num_local):",
    "            node_j = local_to_actual[j]",
    "            loc_dist[i][j] = int(data.dist[node_i][node_j] * SCALE)  # 缩放为整数",
    "",
    "    # ---------- CP-SAT 建模 ----------",
    "    model = cp_model.CpModel()",
    "",
    "    # 弧变量",
    "    arcs = []",
    "    x = {}",
    "    for i in range(num_local):",
    "        for j in range(num_local):",
    "            if i == j:",
    "                continue",
    "            var = model.NewBoolVar(f\"x_{i}_{j}\")",
    "            x[(i, j)] = var",
    "            arcs.append([i, j, var])",
    "",
    "    # 用 AddCircuit 强制单回路（即从仓库出发回到仓库的完整路径）",
    "    model.AddCircuit(arcs)",
    "",
    "    # ========== 时间变量 ==========",
    "    horizon = int(max(loc_tw_end))",
    "    start = {}",
    "    for i in range(num_local):",
    "        start[i] = model.NewIntVar(0, horizon, f\"start_{i}\")",
    "        model.Add(start[i] >= loc_tw_start[i])",
    "        model.Add(start[i] <= loc_tw_end[i])",
    "",
    "    # ========== 时间推进约束 ==========",
    "    BIG_M = horizon",
    "    for (i, j), var in x.items():",
    "        if j == 0:",
    "            # 跳过进入仓库的弧，避免\"start[0] 既是最小又是最大\"的循环矛盾",
    "            continue",
    "        model.Add(",
    "            start[j] >= start[i] + loc_service[i] + loc_dist[i][j]",
    "        ).OnlyEnforceIf(var)   # 只在弧选中时生效",
    "",
    "    # 取货必须在送货之前",
    "    for idx in range(M):",
    "        pu_local = idx + 1",
    "        de_local = idx + M + 1",
    "        model.Add(start[pu_local] <= start[de_local])",
    "",
    "    # ========== 容量约束 ==========",
    "    load = {}",
    "    for i in range(num_local):",
    "        load[i] = model.NewIntVar(0, CAPACITY, f\"load_{i}\")",
    "    # 仓库出发时载重 = 0",
    "    model.Add(load[0] == 0)",
    "    # 载重推进：走 i→j 时，load[j] = load[i] + demand[j]",
    "    for (i, j), var in x.items():",
    "        if j == 0:",
    "            continue    # 跳过返回仓库的弧（载重已归 0，不需要推进）",
    "        model.Add(load[j] == load[i] + loc_demand[j]).OnlyEnforceIf(var)",
    "",
    "",
    "    # 目标函数：最小化总距离",
    "    obj_terms = [loc_dist[i][j] * x[(i, j)] for (i, j) in x]",
    "    model.Minimize(sum(obj_terms))",
    "",
    "    # ---------- 求解 ----------",
    "    solver = cp_model.CpSolver()",
    "    solver.parameters.max_time_in_seconds = time_limit",
    "    status = solver.Solve(model)",
    "",
    "    if status not in (cp_model.OPTIMAL, cp_model.FEASIBLE):",
    "        print(f\"求解失败！回退原路径\")",
    "        return route   # 求解失败，回退原路径",
    "",
    "    # ---------- 提取新路径 ----------",
    "    # 从局部节点 0（仓库）出发，依次追踪后继节点",
    "    new_route_local = [0]",
    "    cur = 0",
    "    # 最多走 num_local 步",
    "    for _ in range(num_local):",
    "        # 找到 cur 的出边",
    "        found = False",
    "        for j in range(num_local):",
    "            if j == cur:",
    "                continue",
    "            if (cur, j) in x and solver.Value(x[(cur, j)]) == 1:",
    "                new_route_local.append(j)",
    "                cur = j",
    "                found = True",
    "                break",
    "        if not found:",
    "            break",
    "        if cur == 0:",
    "            break",
    "",
    "    # 转换成实际节点序列",
    "    new_route = []",
    "    for i in new_route_local:",
    "        new_route.append(int(local_to_actual[i]))",
    "",
    "    # 检查可行性",
    "    from feasibility import check_route",
    "    ok, _, _ = check_route(data, new_route)",
    "    if not ok:",
    "        print(f\"新路径不可行！\")",
    "        return route",
    "    print(f\"求解成功，优化后路线：{new_route}\")",
    "    return new_route",
    "# --- FILE: alns_pdptw/solution.py ---",
    "# -*- coding: utf-8 -*-",
    "\"\"\"",
    "解的表示。",
    "一个解由一组路径组成，每条路径是一串节点序列。",
    "\"\"\"",
    "",
    "from feasibility import check_route, total_cost, all_orders_served",
    "from config import NUM_ORDERS, DEPOT",
    "",
    "",
    "class Solution:",
    "    \"\"\"",
    "    PDPTW 解的封装。",
    "    属性：",
    "        routes: 路径列表，每条路径形如 [0, 5, 105, 0]",
    "        cost  : 当前解的总成本（距离 + 车辆固定成本）",
    "    \"\"\"",
    "",
    "    def __init__(self, routes=None):",
    "        # 如果没传路径，初始化为空",
    "        self.routes = routes if routes is not None else []",
    "        self.cost = float('inf')   # 成本先置为无穷大",
    "",
    "    def copy(self):",
    "        \"\"\"深拷贝：每条路径的列表也要复制，且需要保留 cost\"\"\"",
    "        new_sol = Solution([list(r) for r in self.routes])",
    "        new_sol.cost = self.cost",
    "        return new_sol",
    "",
    "    def evaluate(self, data):",
    "        \"\"\"计算当前解的总成本\"\"\"",
    "        self.cost = total_cost(data, self.routes)",
    "        return self.cost",
    "",
    "    def is_feasible(self, data):",
    "        \"\"\"检查所有路径是否可行，且所有订单被服务\"\"\"",
    "        # 每条路径逐一检查",
    "        for r in self.routes:",
    "            ok, _, _ = check_route(data, r)",
    "            if not ok:",
    "                return False",
    "        # 所有订单是否被覆盖",
    "        return all_orders_served(self.routes, NUM_ORDERS)",
    "",
    "    def remove_order(self, order_id):",
    "        \"\"\"",
    "        从解中移除指定订单。",
    "        返回被移除的两个节点（取货、送货），用于后续重新插入。",
    "        \"\"\"",
    "        pu = order_id + 1",
    "        de = order_id + 1 + NUM_ORDERS",
    "",
    "        # 遍历所有路径，找到包含该订单的路径",
    "        for r_idx, route in enumerate(self.routes):",
    "            if pu in route and de in route:",
    "                # 移除这两个节点",
    "                new_route = [n for n in route if n != pu and n != de]",
    "                # 如果路径只剩仓库，直接删除这条路径",
    "                if len(new_route) <= 2:",
    "                    self.routes.pop(r_idx)",
    "                else:",
    "                    self.routes[r_idx] = new_route",
    "                return pu, de",
    "",
    "        # 理论上不会走到这里",
    "        return pu, de",
    "",
    "    def get_route_of_order(self, order_id):",
    "        \"\"\"返回订单所在的路径索引\"\"\"",
    "        pu = order_id + 1",
    "        for r_idx, route in enumerate(self.routes):",
    "            if pu in route:",
    "                return r_idx",
    "        return -1",
